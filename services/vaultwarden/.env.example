# Public URL this instance is reached at
DOMAIN=https://vaultwarden.your-domain.com

# Set to true only long enough to register your account, then set it
# back to false and restart. An open signup page on a reachable
# instance means anyone can create an account on your server.
SIGNUPS_ALLOWED=false

# Optional, enables the /admin panel. Generate with:
#   openssl rand -base64 48
# Leave unset to keep the admin panel disabled entirely.
# ADMIN_TOKEN=change_me_generate_a_random_token
