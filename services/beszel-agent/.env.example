# Port the agent listens on
LISTEN=45876

# Public key generated by the hub when you add this system
KEY=ssh-ed25519 your-public-key-from-the-hub-ui

# Registration token generated by the hub. This is a credential.
# Never commit the real value.
TOKEN=change_me_token_from_the_hub_ui

# URL of the Beszel hub
HUB_URL=http://your-server-ip:8090
